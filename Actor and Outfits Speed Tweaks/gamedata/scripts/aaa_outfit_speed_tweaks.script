-- Add support for helmet/backpack speed

local last_outfit = 0

outfit_speed_mcm.manage_outfit_speed = function()
    local outfit = db.actor:item_in_slot(7) or db.actor:item_in_slot(12) or db.actor:item_in_slot(13)
    local outfit_id = outfit and outfit:id() or 0
    local outfit_sec = outfit and outfit:section() or "no outfit"
    if last_outfit ~= outfit_id then
        last_outfit = outfit_id
        local coef = outfit and outfit_speed_mcm.get_outfit_speed(outfit, outfit_sec, false) or 1
        local sprint_coef = outfit and outfit_speed_mcm.get_outfit_speed(outfit, outfit_sec, true) or 1
        outfit_speed_mcm.print_dbg("Speed for %s is %s, sprint speed is %s", outfit_sec, coef, sprint_coef)
        speed.add_speed("outfit_speed", coef, false, true)
        speed.add_speed("outfit_sprint_speed", sprint_coef, true, true)
    end
end

PrepStats = utils_ui.prepare_stats_table
function utils_ui.prepare_stats_table()
    PrepStats()
    if not utils_ui.stats_table.backpack.speed then
        utils_ui.stats_table.backpack.speed = { index= 2, typ= "float",   name= "ui_inv_outfit_speed", icon_p= "ui_am_prop_sprint",   icon_n= "", track= false, magnitude= 100, unit= "%", compare= false, sign= false, show_always= false , value_functor= {"outfit_speed_mcm","get_outfit_speed"}}
    end
end