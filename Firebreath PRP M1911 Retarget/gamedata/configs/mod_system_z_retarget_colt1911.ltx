        anm_bore                                 = colt1911_new_inspect, idle
        anm_show                                 = colt1911_new_draw, idle
        anm_hide                                 = colt1911_new_holster, idle

        anm_idle                                 = colt1911_new_idle, idle
        anm_idle_aim_moving                      = colt1911_new_walk, idle 
        anm_idle_aim_moving_crouch               = colt1911_new_walk, idle, 0.8 
        anm_idle_moving                          = colt1911_new_walk, idle
        anm_idle_moving_crouch                   = colt1911_new_walk, idle
        anm_idle_sprint                          = colt1911_new_sprint, idle, 1.2

        anm_reload                               = colt1911_new_reload_nobump, reload_nobump
        anm_reload_empty                         = colt1911_new_reload_empty_nobump, reload_empty_nobump
        anm_reload_misfire          		     = colt1911_new_unjam, unjam

        ; anm_switch_mode                 	     = colt1911_new_switchmode, switch_mode

        anm_shots                                = colt1911_new_shoot_hip
        anm_shots_aim                            = colt1911_new_shoot_aim
        anm_shots_aim_l                          = colt1911_new_shoot_aim, shoot_empty
        anm_idle_aim                             = colt1911_new_aim, idle


        anm_bore_empty                                 = colt1911_new_inspect, idle_empty
        anm_show_empty                                 = colt1911_new_draw, idle_empty
        anm_hide_empty                                 = colt1911_new_holster, idle_empty
        anm_shot_l                                     = colt1911_new_shoot_hip, shoot_empty

        anm_idle_empty                                 = colt1911_new_idle, idle_empty
        anm_idle_aim_moving_empty                      = colt1911_new_walk, idle_empty
        anm_idle_aim_moving_crouch_empty               = colt1911_new_walk, idle_empty, 0.8
        anm_idle_moving_empty                          = colt1911_new_walk, idle_empty
        anm_idle_moving_crouch_empty                   = colt1911_new_walk, idle_empty, 0.9
        anm_idle_sprint_empty                          = colt1911_new_sprint, idle_empty, 1.2

        ; anm_switch_mode_empty			       = colt1911_new_switchmode_empty, switch_mode_empty
        anm_idle_aim_empty                             = colt1911_new_aim, idle_empty



        ; Jammed Animation Variants
        anm_idle_jammed                    = colt1911_new_idle, idle_jammed
        anm_show_jammed                    = colt1911_new_draw, idle_jammed
        anm_hide_jammed                    = colt1911_new_holster, idle_jammed
        anm_idle_aim_jammed                = colt1911_new_aim, idle_jammed
        anm_idle_sprint_jammed             = colt1911_new_sprint, idle_jammed, 1.2
        anm_idle_moving_jammed             = colt1911_new_walk, idle_jammed
        anm_idle_moving_crouch_jammed      = colt1911_new_walk, idle_jammed, 0.8
        anm_bore_jammed                    = colt1911_new_inspect_jammed, idle_jammed
        ;anm_reload_misfire                 = colt1911_new_unjam, unjam


        anm_walk2sprint_jammed             = colt1911_new_walk2sprint, idle_jammed
        anm_sprint2walk_jammed             = colt1911_new_sprint2walk, idle_jammed


        ; Empty Jammed Animation Variants
        anm_idle_empty_jammed                    = colt1911_new_idle, idle_jammed
        anm_show_empty_jammed                    = colt1911_new_draw, idle_jammed
        anm_hide_empty_jammed                    = colt1911_new_holster, idle_jammed
        anm_idle_aim_empty_jammed                = colt1911_new_aim, idle_jammed
        anm_idle_sprint_empty_jammed             = colt1911_new_sprint, idle_jammed, 1.2
        anm_idle_moving_empty_jammed             = colt1911_new_walk, idle_jammed
        anm_idle_moving_crouch_empty_jammed      = colt1911_new_walk, idle_jammed, 0.8
        anm_bore_empty_jammed                    = colt1911_new_inspect_jammed, idle_jammed
        anm_reload_misfire_empty                 = colt1911_new_unjam_empty, unjam_empty
        anm_shot_l_jammed                        = colt1911_new_idle, idle_jammed
        anm_shots_jammed                   	 = colt1911_new_idle, idle_jammed

        anm_walk2sprint_empty_jammed             = colt1911_new_walk2sprint, idle_jammed
        anm_sprint2walk_empty_jammed             = colt1911_new_sprint2walk, idle_jammed

        ; Custom Animations Handled In Scripts
        anm_ammo_check                           = colt1911_new_magcheck, magcheck
        anm_ammo_check_empty                     = colt1911_new_magcheck, magcheck_empty
        ;anm_ammo_check_no_mag                    = colt1911_new_magcheck_nomag, magcheck_nomag
        ;anm_ammo_check_aim                       = colt1911_new_magcheck_ads, magcheck_ads
        ;anm_ammo_check_empty_aim                 = colt1911_new_magcheck_ads, magcheck_empty_ads
        anm_ammo_check_jammed                    = colt1911_new_magcheck, magcheck_jammed
        anm_ammo_check_empty_jammed              = colt1911_new_magcheck, magcheck_jammed_empty
        ; anm_switch_mode_jammed                  	     = colt1911_new_switchmode_jammed, switch_mode_jammed
        ; anm_switch_mode_empty_jammed                  	     = colt1911_new_switchmode_jammed, switch_mode_jammed
         ; Transition/Intermediate Animations
        anm_walk2sprint             = colt1911_new_walk2sprint
        anm_walk2sprint_empty = colt1911_new_walk2sprint, idle_empty

        anm_sprint2walk             = colt1911_new_sprint2walk
        anm_sprint2walk_empty       = colt1911_new_sprint2walk, idle_empty

        ; anm_idle2aim             = colt1911_new_idle2aim
        ; anm_idle2aim_empty       = colt1911_new_idle2aim, idle_empty
        
        ; Transition Definitions
        ts_pattern_walk2sprint      = .+, anm_idle_sprint, anm_walk2sprint, 1

        ts_pattern_sprint2walk      = anm_idle_sprint, ^anm_idle.*, anm_sprint2walk, 1
        ts_pattern_sprint2walk_aim  = anm_walk2sprint, ^anm_idle_aim.*, anm_sprint2walk, 1
        ts_strict_sprint2walk_idle  = anm_walk2sprint, anm_idle, anm_sprint2walk
        ts_strict_sprint2walk_move  = anm_walk2sprint, anm_idle_moving, anm_sprint2walk

        ;ts_pattern_idle2aim         = ^anm_idle.*, ^anm_idle_aim$, anm_idle2aim, 1
        ts_strict_sprint2aim        = anm_idle_sprint, anm_idle_aim, anm_sprint2walk

        ts_strict_sprint2inspect        = anm_idle_sprint, anm_bore, anm_sprint2walk
        ts_strict_walk2sprint_inspect        = anm_walk2sprint, anm_bore, anm_sprint2walk


        !anm_sprint_start
        !anm_sprint_end
        !anm_sprint_start_empty
        !anm_sprint_end_empty
        !anm_sprint_start_jammed
        !anm_sprint_end_jammed
        !anm_idle_aim_moving_jammed
        !anm_idle_aim_moving_crouch_jammed
        !anm_idle_aim_start_jammed
        !anm_idle_aim_end_jammed
        !anm_idle_aim_end_empty
        !anm_idle_aim_start_empty
        !anm_idle_aim_end
        !anm_idle_aim_start
        !ts_pattern_sprint_start      
        !ts_pattern_sprint_end      
        !ts_strict_sprint_end_move  
        !anm_shots_aim
        !anm_shots_aim_l


