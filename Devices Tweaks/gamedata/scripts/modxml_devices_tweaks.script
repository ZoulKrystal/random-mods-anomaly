function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if xml_file_name == [[text\eng\ui_st_options.xml]]
		then
            local res = xml_obj:query("string[id=ui_mm_gameplay_gameplay_diff_notify_anomaly] > text")
            local res1 = xml_obj:query("string[id=ui_mm_gameplay_gameplay_diff_notify_anomaly_desc] > text")
            if res[1] then
				local el = res[1]
				local el_text = xml_obj:getText(el)
				if el_text then
					xml_obj:setText(el, "Play warning beeps from the Anomaly detector only")
				end
			end
            if res1[1] then
				local el = res1[1]
				local el_text = xml_obj:getText(el)
				if el_text then
					xml_obj:setText(el, "%c[ui_gray_1]Disabled:%c[ui_gray_2] The player will hear warning beeps upon approaching anomalies.\\n \\n%c[ui_gray_1]Enabled:%c[ui_gray_2] The beeps can be heard only if the player posses a Anomaly Detector in their inventory with enough battery power.")
				end
			end
		end
	end)
end